# Copy this file to .env and fill in your real local values.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bakery_db
DB_USER=hamad
DB_PASSWORD=your_database_password_here

# development by default; set to production when deploying
NODE_ENV=development

# Optional: port for the Express server
PORT=5000

# Frontend origin allowed to call the API
CLIENT_URL=http://localhost:3000

# JWT settings (change JWT_SECRET in production)
JWT_SECRET=REPLACE_ME_WITH_A_VERY_LONG_RANDOM_STRING
JWT_EXPIRES_IN=7d
CLOUDINARY_URL=cloudinary://YOUR_CLOUDINARY_API_KEY:YOUR_CLOUDINARY_API_SECRET@YOUR_CLOUDINARY_CLOUD_NAME